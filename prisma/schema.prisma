generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

model User {
  id                  String    @id
  name                String
  email               String
  emailVerified       Boolean   @default(false)
  image               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  phoneNumber         String?
  phoneNumberVerified Boolean?
  role                Role      @default(user)
  banned              Boolean?
  banReason           String?
  banExpires          DateTime?
  sessions            Session[]
  accounts            Account[]

  listings           Listing[]
  reservations       Reservation[]
  favorites          Favorite[]
  reviews            Review[]
  guestConversations Conversation[] @relation("GuestConversations")
  hostConversations  Conversation[] @relation("HostConversations")
  messages           Message[]

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ListingCategory {
  beach
  villa
  ecoLodge
  traditional
  apartment
  desert
  mountain
  luxury
}

// Amenities are stable string keys (wifi, parking, pool...) translated at the
// display layer via messages/*.json - never store localized text in the DB.
model Listing {
  id            String          @id @default(cuid())
  title         String
  description   String
  coverImage    String
  images        String[]
  category      ListingCategory
  amenities     String[]        @default([])
  guestCount    Int
  bedroomCount  Int
  bedCount      Int
  bathroomCount Int
  // Stored in Toman. USD display/charge derives from the FX rate locked on
  // each reservation at creation time.
  pricePerNight Int
  country       String          @default("IR")
  province      String?
  city          String
  address       String?
  latitude      Float?
  longitude     Float?
  published     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  reservations  Reservation[]
  favorites     Favorite[]
  reviews       Review[]
  conversations Conversation[]

  @@index([city])
  @@index([category])
  @@index([userId])
  @@map("listing")
}

enum PaymentStatus {
  Pending
  Paid
  Failed
  Declined
  Cancelled
  Refunded
  PartiallyRefunded
  Chargeback
}

// A Pending reservation holds its dates (blocks overlap) until it is paid,
// cancelled by the guest/host, or swept by the stale-pending cron job.
model Reservation {
  id            String        @id @default(cuid())
  startDate     DateTime
  endDate       DateTime
  nights        Int
  guests        Int
  // Server-computed snapshot in Toman - locked at creation, never re-read
  // from the listing afterwards and never accepted from the client.
  totalPrice    Int
  // Toman-per-USD rate at creation; used to derive the Stripe charge amount.
  exchangeRate  Float?
  paymentStatus PaymentStatus @default(Pending)
  // Zarinpal authority / Stripe PaymentIntent id. Unique so no two orders can
  // ever claim the same gateway reference - DB-level backstop.
  authority     String?       @unique
  paymentMethod String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  listingId     String
  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  review        Review?
  paymentDetail PaymentDetails?

  @@index([listingId, startDate, endDate])
  @@index([userId])
  @@index([paymentStatus])
  @@map("reservation")
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Atomic toggle backstop - prevents duplicate favorites under races.
  @@unique([userId, listingId])
  @@index([listingId])
  @@map("favorite")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // One review per guest per listing; tied to a completed stay in actions.
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([listingId, userId])
  @@index([listingId])
  @@map("review")
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guestId   String
  guest     User     @relation("GuestConversations", fields: [guestId], references: [id], onDelete: Cascade)
  hostId    String
  host      User     @relation("HostConversations", fields: [hostId], references: [id], onDelete: Cascade)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([guestId])
  @@index([hostId])
  @@index([listingId])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("message")
}

// ---------------------------------------------------------------------------
// Payment safety tables (ordering-flow skill). Every unique constraint here is
// load-bearing: they serialize concurrent verifications, block replayed
// authorities, and give reconciliation something durable to work from.
// ---------------------------------------------------------------------------

model PaymentDetails {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  // Zarinpal authority / Stripe PaymentIntent id
  authority     String      @db.Text
  // Customer-facing tracking code (Zarinpal ref_id / Stripe charge id)
  transactionId String?
  method        String
  status        String
  amount        Int
  currency      String      @default("IRT")
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([authority])
  @@map("payment_details")
}

model PaymentLock {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  // Unique reservationId = distributed lock: second concurrent verify loses.
  reservationId String   @unique
  authority     String

  @@index([expiresAt])
  @@map("payment_lock")
}

model PaymentAttempt {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  amount        Int
  // PENDING | SUCCESS | FAILED | USED
  status        String   @default("PENDING")
  reservationId String
  authority     String

  // Replay guard: an authority can only ever be processed once per order.
  @@unique([reservationId, authority])
  @@index([authority])
  @@map("payment_attempt")
}

model PaymentRateLimit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String

  @@index([userId, createdAt])
  @@map("payment_rate_limit")
}
